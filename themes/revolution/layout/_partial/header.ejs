<header class="top-app-bar">
  <div class="app-bar-inner">
    <button class="icon-button" id="menu-toggle" aria-label="打开菜单" aria-controls="nav-drawer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <a class="brand" href="<%- url_for('/') %>">
      <img class="brand-logo" src="<%- url_for(theme.logo) %>" alt="" aria-hidden="true">
      <span class="brand-text">
        <span class="brand-name"><%= theme.brand.name || config.title %></span>
        <% if (theme.brand.suffix){ %><span class="brand-suffix"><%= theme.brand.suffix %></span><% } %>
      </span>
    </a>

    <nav class="app-bar-nav" aria-label="主导航">
      <% Object.keys(theme.menu).forEach(function(name){
        var link = theme.menu[name];
        var p = page.path || '';
        var active = (link === '/' && (p === '' || p === 'index.html')) || (link !== '/' && (p === link.slice(1) || p.indexOf(link.slice(1)) === 0));
      %>
        <a class="nav-item<%= active ? ' active' : '' %>" href="<%- url_for(link) %>"><%= name %></a>
      <% }); %>
    </nav>

    <button class="icon-button" id="theme-toggle" aria-label="切换主题">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <div class="app-bar-progress" aria-hidden="true"><div class="app-bar-progress-fill" id="reading-progress"></div></div>
</header>
