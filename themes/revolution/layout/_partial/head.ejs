<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Hexo">

  <% var pageTitle = '';
  if (is_archive()){
    pageTitle = __('archive');
    if (is_month()){ pageTitle += ' · ' + page.year + '/' + page.month; }
    else if (is_year()){ pageTitle += ' · ' + page.year; }
  } else if (is_category()){
    pageTitle = __('category') + ' · ' + page.category;
  } else if (is_tag()){
    pageTitle = __('tag') + ' · ' + page.tag;
  } else if (page.title){
    pageTitle = page.title;
  } %>
  <title><%= pageTitle ? pageTitle + ' · ' : '' %><%= config.title %></title>

  <%- open_graph({
    type: is_home() ? 'website' : 'article',
    url: config.url + '/' + page.path,
    image: url_for(theme.logo) ? config.url + url_for(theme.logo) : ''
  }) %>

  <% if (theme.favicon){ %>
    <link rel="icon" type="image/svg+xml" href="<%- url_for(theme.favicon) %>">
  <% } %>

  <!-- 防闪烁：在渲染前设置主题 -->
  <script>
    (function(){
      var t = localStorage.getItem('theme');
      if (!t) t = '<%= theme.darkmode === "dark" ? "dark" : (theme.darkmode === "light" ? "light" : "auto") %>';
      var dark = t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    })();
  </script>

  <%- css('css/style.css') %>
</head>
