<div class="container">
  <%- partial('_partial/status-banner') %>

  <section class="hero">
    <svg class="hero-star" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/>
    </svg>
    <div class="hero-content">
      <h1 class="hero-title"><%= config.title %></h1>
      <% if (config.subtitle){ %><p class="hero-subtitle"><%= config.subtitle %></p><% } %>
      <p class="hero-slogan">「<%= theme.footer.slogan %>」</p>
    </div>
  </section>

  <div class="post-list">
    <% var posts = page.posts.toArray ? page.posts.toArray() : page.posts;
       for (const post of posts) { %>
      <%- partial('_partial/post-card', {post: post}) %>
    <% } %>
  </div>

  <%- partial('_partial/pagination') %>
</div>
