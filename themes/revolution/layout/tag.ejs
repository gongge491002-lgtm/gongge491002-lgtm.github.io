<div class="container">
  <h1 class="page-heading">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V5a2 2 0 0 1 2-2h7a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8zM7.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    标签
  </h1>

  <div class="tag-cloud">
    <% var tags = site.tags.toArray().sort(function(a, b){ return b.length - a.length; });
       var maxLen = tags.length ? tags[0].length : 1;
       for (const tag of tags) {
         var ratio = maxLen > 1 ? (tag.length - 1) / (maxLen - 1) : 0;
         var size = 0.85 + ratio * 0.75; // 0.85em ~ 1.6em
    %>
      <a class="chip tag-chip" href="<%- url_for(tag.path) %>" style="font-size: <%= size %>em;">
        <%= tag.name %>
        <span class="tag-count"><%= tag.length %></span>
      </a>
    <% } %>
  </div>
</div>
