<div class="container post-layout">
  <article class="card post-article">
    <header class="post-header">
      <h1 class="post-title"><%= page.title %></h1>
      <div class="post-meta">
        <time class="meta-item" datetime="<%- date_xml(page.date) %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 7v13a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V7M7 7V4m10 3V4M8 12h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <%= date(page.date, 'YYYY年M月D日') %>
        </time>
        <% if (theme.post.show_author && page.author){ %>
          <span class="meta-item">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-8 8a8 8 0 0 1 16 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <%= page.author %>
          </span>
        <% } %>
        <% if (page.categories && page.categories.length){ %>
          <% page.categories.forEach(function(cat){ %>
            <a class="meta-item meta-link" href="<%- url_for(cat.path) %>">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              <%= cat.name %>
            </a>
          <% }); %>
        <% } %>
      </div>
    </header>

    <div class="post-content" id="post-content">
      <%- page.content %>
    </div>

    <% if (page.tags && page.tags.length){ %>
      <footer class="post-tags">
        <div class="chip-row">
          <% page.tags.forEach(function(tag){ %>
            <a class="chip" href="<%- url_for(tag.path) %>"># <%= tag.name %></a>
          <% }); %>
        </div>
      </footer>
    <% } %>

    <% if (theme.post.prev_next){ %>
      <nav class="post-nav" aria-label="上一篇下一篇">
        <% if (page.prev){ %>
          <a class="post-nav-link prev" href="<%- url_for(page.prev.path) %>">
            <span class="post-nav-label">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              上一篇
            </span>
            <span class="post-nav-title"><%= page.prev.title %></span>
          </a>
        <% } else { %>
          <span></span>
        <% } %>
        <% if (page.next){ %>
          <a class="post-nav-link next" href="<%- url_for(page.next.path) %>">
            <span class="post-nav-label">
              下一篇
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="post-nav-title"><%= page.next.title %></span>
          </a>
        <% } else { %>
          <span></span>
        <% } %>
      </nav>
    <% } %>
  </article>

  <% if (theme.post.toc !== false){ %>
    <aside class="toc-column" aria-label="文章目录">
      <nav class="toc" id="toc"></nav>
    </aside>
  <% } %>
</div>
